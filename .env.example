# Copy to .env.local. Both values are public by design (they ship to the
# browser); the database's row-level security is what protects family data.
# Find them in Supabase: Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Never add the secret (service role) key here. The app does not need it.

# The site's public address, used in invitation links. Set on the live site
# only (e.g. https://bryan-family.com). Leave unset on your computer.
# SITE_URL=https://bryan-family.com
